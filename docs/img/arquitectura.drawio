<mxfile host="app.diagrams.net"><diagram name="Arquitectura" id="paylake-arquitectura"><mxGraphModel dx="1600" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="700" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Arquitectura de Datos End-to-End · Payments Lakehouse en AWS&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;whiteSpace=wrap;fontSize=30;fontColor=#13294b;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1520" height="50" as="geometry"/></mxCell><mxCell id="subtitle" value="Ingesta → &lt;b&gt;Bronze&lt;/b&gt; (crudo) → &lt;b&gt;Silver&lt;/b&gt; (limpio) → &lt;b&gt;Gold&lt;/b&gt; (productos de datos) → Consumo e intercambio" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;whiteSpace=wrap;fontSize=16;fontColor=#5b6b82;" vertex="1" parent="1"><mxGeometry x="40" y="82" width="1520" height="30" as="geometry"/></mxCell><mxCell id="card0" value='&lt;div style="text-align:center;font-size:30px"&gt;🏦&lt;/div&gt;&lt;div style="text-align:center;font-size:11px;letter-spacing:1.5px;margin-top:4px"&gt;&lt;b&gt;FUENTES&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align:center;font-size:18px;margin:6px 0 12px 0"&gt;&lt;b&gt;Origen de datos&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align:left;font-size:13px;line-height:1.55"&gt;•&amp;nbsp;Adquirentes: autorizaciones en JSON (con PAN)&lt;br&gt;•&amp;nbsp;Core bancario en PostgreSQL (RDS)&lt;br&gt;•&amp;nbsp;Extracto JSON del core&lt;/div&gt;' style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#4f6fd6;strokeColor=none;fontColor=#ffffff;verticalAlign=top;align=center;spacingTop=16;spacingLeft=14;spacingRight=14;shadow=1;" vertex="1" parent="1"><mxGeometry x="65" y="140" width="270" height="330" as="geometry"/></mxCell><mxCell id="card1" value='&lt;div style="text-align:center;font-size:30px"&gt;📥&lt;/div&gt;&lt;div style="text-align:center;font-size:11px;letter-spacing:1.5px;margin-top:4px"&gt;&lt;b&gt;INGESTA&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align:center;font-size:18px;margin:6px 0 12px 0"&gt;&lt;b&gt;Bronze · S3&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align:left;font-size:13px;line-height:1.55"&gt;•&amp;nbsp;Lambda de ingesta cada hora&lt;br&gt;•&amp;nbsp;AWS DMS: carga completa + CDC&lt;br&gt;•&amp;nbsp;Dato crudo e inmutable, cifrado con KMS&lt;/div&gt;' style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#0f9a8f;strokeColor=none;fontColor=#ffffff;verticalAlign=top;align=center;spacingTop=16;spacingLeft=14;spacingRight=14;shadow=1;" vertex="1" parent="1"><mxGeometry x="375" y="140" width="270" height="330" as="geometry"/></mxCell><mxCell id="card2" value='&lt;div style="text-align:center;font-size:30px"&gt;🧹&lt;/div&gt;&lt;div style="text-align:center;font-size:11px;letter-spacing:1.5px;margin-top:4px"&gt;&lt;b&gt;TRANSFORMACIÓN&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align:center;font-size:18px;margin:6px 0 12px 0"&gt;&lt;b&gt;Silver · S3&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align:left;font-size:13px;line-height:1.55"&gt;•&amp;nbsp;Python: pandas + AWS SDK for pandas&lt;br&gt;•&amp;nbsp;Calidad de datos y cuarentena&lt;br&gt;•&amp;nbsp;Tokenización del PAN (HMAC)&lt;br&gt;•&amp;nbsp;Deduplicación y modelo único&lt;/div&gt;' style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#7a52d1;strokeColor=none;fontColor=#ffffff;verticalAlign=top;align=center;spacingTop=16;spacingLeft=14;spacingRight=14;shadow=1;" vertex="1" parent="1"><mxGeometry x="685" y="140" width="270" height="330" as="geometry"/></mxCell><mxCell id="card3" value='&lt;div style="text-align:center;font-size:30px"&gt;🏅&lt;/div&gt;&lt;div style="text-align:center;font-size:11px;letter-spacing:1.5px;margin-top:4px"&gt;&lt;b&gt;PRODUCTOS DE DATOS&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align:center;font-size:18px;margin:6px 0 12px 0"&gt;&lt;b&gt;Gold · S3&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align:left;font-size:13px;line-height:1.55"&gt;•&amp;nbsp;KPIs por comercio&lt;br&gt;•&amp;nbsp;Liquidación de intercambio&lt;br&gt;•&amp;nbsp;Alertas de fraude + precisión&lt;br&gt;•&amp;nbsp;Glue PySpark + Data Quality&lt;/div&gt;' style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#e07b1a;strokeColor=none;fontColor=#ffffff;verticalAlign=top;align=center;spacingTop=16;spacingLeft=14;spacingRight=14;shadow=1;" vertex="1" parent="1"><mxGeometry x="995" y="140" width="270" height="330" as="geometry"/></mxCell><mxCell id="card4" value='&lt;div style="text-align:center;font-size:30px"&gt;📊&lt;/div&gt;&lt;div style="text-align:center;font-size:11px;letter-spacing:1.5px;margin-top:4px"&gt;&lt;b&gt;CONSUMO&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align:center;font-size:18px;margin:6px 0 12px 0"&gt;&lt;b&gt;Análisis e intercambio&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align:left;font-size:13px;line-height:1.55"&gt;•&amp;nbsp;Athena: SQL avanzado&lt;br&gt;•&amp;nbsp;Power BI (rol analista)&lt;br&gt;•&amp;nbsp;API REST sobre Gold&lt;br&gt;•&amp;nbsp;Archivos de liquidación por banco&lt;/div&gt;' style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#2a9d55;strokeColor=none;fontColor=#ffffff;verticalAlign=top;align=center;spacingTop=16;spacingLeft=14;spacingRight=14;shadow=1;" vertex="1" parent="1"><mxGeometry x="1305" y="140" width="270" height="330" as="geometry"/></mxCell><mxCell id="arrow0" style="endArrow=classic;html=1;rounded=0;strokeColor=#9aa8bc;strokeWidth=2;endSize=8;" edge="1" parent="1" source="card0" target="card1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="arrow1" style="endArrow=classic;html=1;rounded=0;strokeColor=#9aa8bc;strokeWidth=2;endSize=8;" edge="1" parent="1" source="card1" target="card2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="arrow2" style="endArrow=classic;html=1;rounded=0;strokeColor=#9aa8bc;strokeWidth=2;endSize=8;" edge="1" parent="1" source="card2" target="card3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="arrow3" style="endArrow=classic;html=1;rounded=0;strokeColor=#9aa8bc;strokeWidth=2;endSize=8;" edge="1" parent="1" source="card3" target="card4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="box0" value='&lt;div style="font-size:15px"&gt;&lt;b&gt;⏱️&amp;nbsp; Orquestación — Step Functions + EventBridge&lt;/b&gt;&lt;/div&gt;&lt;div style="font-size:13px;color:#5b6b82;margin-top:6px"&gt;Pipeline horario con reintentos; job de Glue diario; alarmas si algo falla.&lt;/div&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef2fc;strokeColor=#c9d4f3;strokeWidth=1.5;fontColor=#13294b;align=left;verticalAlign=top;spacingTop=12;spacingLeft=16;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="65" y="505" width="480" height="100" as="geometry"/></mxCell><mxCell id="box1" value='&lt;div style="font-size:15px"&gt;&lt;b&gt;🔐&amp;nbsp; Gobierno y seguridad&lt;/b&gt;&lt;/div&gt;&lt;div style="font-size:13px;color:#5b6b82;margin-top:6px"&gt;IAM de mínimo privilegio + permissions boundary · Lake Formation (el analista sólo ve Gold) · KMS · CloudTrail.&lt;/div&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fdf2f6;strokeColor=#f1cddc;strokeWidth=1.5;fontColor=#13294b;align=left;verticalAlign=top;spacingTop=12;spacingLeft=16;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="585" y="505" width="480" height="100" as="geometry"/></mxCell><mxCell id="box2" value='&lt;div style="font-size:15px"&gt;&lt;b&gt;☁️&amp;nbsp; Despliegue y observabilidad&lt;/b&gt;&lt;/div&gt;&lt;div style="font-size:13px;color:#5b6b82;margin-top:6px"&gt;Terraform + CloudFormation · GitHub Actions (OIDC) · CloudWatch: métricas, alarmas y registro de cada despliegue.&lt;/div&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#edf7f0;strokeColor=#c6e5d0;strokeWidth=1.5;fontColor=#13294b;align=left;verticalAlign=top;spacingTop=12;spacingLeft=16;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="1105" y="505" width="480" height="100" as="geometry"/></mxCell><mxCell id="footer" value="Datos sintéticos · Python · SQL · Terraform · AWS (sa-east-1) · S3 · Lambda · DMS · Glue · Athena · Lake Formation · Power BI" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;whiteSpace=wrap;fontSize=13;fontColor=#5b6b82;" vertex="1" parent="1"><mxGeometry x="40" y="630" width="1520" height="30" as="geometry"/></mxCell><mxCell id="rule" value="" style="line;strokeWidth=1.5;html=1;strokeColor=#d9e1ec;fillColor=none;" vertex="1" parent="1"><mxGeometry x="65" y="620" width="1470" height="4" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>